{
  "name": "pcic-react-leaflet-components",
  "version": "4.0.0",
  "private": true,
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "source": "src/index.js",
  "dependencies": {
    "lodash": "^4.17.21",
    "proj4": "^2.8.0",
    "proj4leaflet": "^1.0.2",
    "prop-types": "^15.8.1",
    "svg-loaders-react": "^2.2.1"
  },
  "scripts": {
    "dev": "concurrently -n lib,pg -c blue,green \"npm:build:watch\" \"npm:dev:pg\"",
    "dev:pg": "npm --prefix playground run dev",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:all": "npm ci && npm --prefix playground ci"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@react-leaflet/core": "2.0.0",
    "leaflet": "^1.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "4.0.0"
  },
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  }
}
